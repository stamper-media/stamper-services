{
  "name": "stamper-services",
  "private": true,
  "version": "0.1.0",
  "description": "Stamper services: the custodian api and key-free worker (one image, ROLE=api|worker), the ml sidecar (TrustMark, PDQ), and the whole-flow e2e scripts.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:anvil": "pnpm -r --if-present test:anvil",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:ml": "cd services/ml && .venv/bin/python -m pytest -q",
    "e2e:local": "e2e/run-local.sh",
    "e2e:calibration": "e2e/run-calibration.sh",
    "stack:calibration": "e2e/stack-calibration.sh",
    "sync-protocol": "scripts/sync-protocol.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
